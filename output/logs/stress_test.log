. *----------------------------------------------------------------------------
. * 3. Recursion over forecast quarters
. *----------------------------------------------------------------------------
. local tax = $P_tax_rate

. local pay = $P_payout

. local w   = $P_w_srbi

. local k   = $P_k_stress * $use_overlay

. 
. forval t = `=$base_q + 1'/`=$base_q + $horizon' {
  2.     local q "quarter == `t'"
  3.     gen double _g = (1 + gdp/100)^0.25 - 1 if `q'
  4.     foreach v in asset loan dep rwa sec_amt {
  5.         replace `v' = L.`v' * (1 + _g) if `q'
  6.     }
  7.     drop _g
  8. 
.     * credit risk
.     replace lnpl    = c_npl + $b_rho*L.lnpl + $b_gdp4*gdp4 + $b_rep4*rep4    
>  ///
>                       + $b_prp4*prp4 if `q'
  9.     replace npl_r   = 100 * invlogit(lnpl) if `q'
 10.     replace npl_amt = npl_r / 100 * loan if `q'
 11.     replace prov_r  = max(0, c_prov + $g1*npl_r + $g2*(npl_r - L.npl_r)) i
> f `q'
 12.     replace overlay = `k' * max(0, gdp_bl - gdp) * npl_amt if `q'
 13.     replace prov    = prov_r / 100 * loan + overlay if `q'
 14. 
.     * market risk on MTM securities held at the start of the quarter
.     replace mtm        = -d_price / 100 * L.sec_amt * (1 - `w') if `q'
 15.     replace fvtpl_loss = fvtpl_sh * mtm if `q'
 16.     replace oci_loss   = (1 - fvtpl_sh) * mtm if `q'
 17. 
.     * income statement
.     replace nii   = nim_4q / 100 * asset                                     
>   ///
>                     + ($beta_loan*loan - $beta_dep*dep) * (reporate - repo_ba
> se) / 400 if `q'
 18.     replace nonii = nonii_r_4q / 100 * asset if `q'
 19.     replace nonie = nonie_r_4q / 100 * asset if `q'
 20.     replace ebt   = nii + nonii - nonie - prov - fvtpl_loss if `q'
 21.     replace tax   = `tax' * max(ebt, 0) if `q'
 22.     replace eat   = ebt - tax if `q'
 23.     replace div   = `pay' * max(eat, 0) if `q'
 24. 
.     * capital
.     replace tier1 = L.tier1 + eat - div - oci_loss if `q'
 25.     replace cap   = L.cap   + eat - div - oci_loss if `q'
 26. }
